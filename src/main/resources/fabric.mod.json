{
  "schemaVersion": 1,
  "name": "Monocle Client",
  "id": "monocle-client",
  "version": "${version}",
  "description": "A focused Minecraft utility client for anarchy servers.",
  "authors": [
    "Monocle contributors"
  ],
  "license": "GPL-3.0",
  "icon": "assets/monocle-client/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.monocle.client.MonocleClient"
    ],
    "modmenu": [
      "dev.monocle.client.modintegration.ModMenuIntegration"
    ]
  },
  "mixins": [
    "monocle-client.mixins.json",
    "monocle-client-baritone.mixins.json",
    "monocle-client-indigo.mixins.json",
    "monocle-client-sodium.mixins.json",
    "monocle-client-lithium.mixins.json",
    "monocle-client-viafabricplus.mixins.json",
    "monocle-client-printer.mixins.json"
  ],
  "accessWidener": "monocle-client.classtweaker",
  "custom": {
    "monocle-client:build_number": "${build_number}",
    "monocle-client:color": "35,205,190",
    "monocle-client:commit": "${commit}",
    "badoptimizations:cache_hooks": {
      "lightmap": "dev.monocle.client.modintegration.BadOptimizationsHook"
    }
  },
  "depends": {
    "java": ">=${jdk_version}",
    "minecraft": "${minecraft_version}",
    "fabricloader": ">=${loader_version}"
  },
  "breaks": {
    "optifabric": "*",
    "feather": "*",
    "origins": "*",
    "sodium": "<0.9.1",
    "morechathistory": "*",
    "lithium": "<0.22.1"
  }
}
